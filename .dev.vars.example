# Copy to .dev.vars for local `wrangler pages dev`. Never commit .dev.vars.
# These are placeholders. Do not put a live key here. Prefer a restricted
# Stripe test key (rk_test_...) over a secret key (sk_test_...) when you
# connect a real Stripe sandbox. Webhook signing secrets are secrets too.

STRIPE_SECRET_KEY=replace_me_restricted_test_key
STRIPE_WEBHOOK_SECRET=replace_me_webhook_signing_secret
COOKIE_SECRET=replace_me_with_a_long_random_string_at_least_32_chars

# Local only. The simulate-payment route also refuses any host that is not
# localhost. Leave this unset on Cloudflare Pages.
ENABLE_PAYMENT_SIMULATION=true
